{
  "$meta": {
    "description": "全社共通デザイントークンの唯一のソース。値は HSL の成分文字列（'H S% L%'）で持つ。",
    "generates": [
      "tokens/tokens.css",
      "tokens/index.ts",
      "tailwind/preset.js",
      "tailwind/v4.css"
    ],
    "build": "node scripts/build-tokens.mjs",
    "check": "node scripts/check-contrast.mjs",
    "rules": [
      "値を変えたら必ず build → check を通す（AA 4.5:1 未満は exit 1）",
      "dark に値が無いトークンは null。勝手に値を作らない",
      "プロダクト固有の色（brand / sidebar / chart / ドメイン状態色）はここに入れない"
    ]
  },

  "neutral": {
    "background": {
      "light": "0 0% 100%",
      "dark": "0 0% 3.9%",
      "usage": "ページの地色"
    },
    "foreground": {
      "light": "0 0% 3.9%",
      "dark": "0 0% 98%",
      "usage": "既定の本文文字色"
    },
    "card": {
      "light": "0 0% 100%",
      "dark": "0 0% 3.9%",
      "usage": "カード・パネルの面"
    },
    "card-foreground": {
      "light": "0 0% 3.9%",
      "dark": "0 0% 98%",
      "usage": "カード面の文字色"
    },
    "popover": {
      "light": "0 0% 100%",
      "dark": "0 0% 3.9%",
      "usage": "ポップオーバー・ドロップダウンの面"
    },
    "popover-foreground": {
      "light": "0 0% 3.9%",
      "dark": "0 0% 98%",
      "usage": "ポップオーバー面の文字色"
    },
    "primary": {
      "light": "0 0% 9%",
      "dark": "0 0% 98%",
      "usage": "主要アクション（既定のボタン塗り）。neutral であり『青＝主要』ではない"
    },
    "primary-foreground": {
      "light": "0 0% 98%",
      "dark": "0 0% 9%",
      "usage": "primary 面の上の文字色"
    },
    "secondary": {
      "light": "0 0% 96.1%",
      "dark": "0 0% 14.9%",
      "usage": "副次アクションの面"
    },
    "secondary-foreground": {
      "light": "0 0% 9%",
      "dark": "0 0% 98%",
      "usage": "secondary 面の上の文字色"
    },
    "muted": {
      "light": "0 0% 96.1%",
      "dark": "0 0% 14.9%",
      "usage": "薄い面（ゼブラ行・非強調ブロック）"
    },
    "muted-foreground": {
      "light": "0 0% 43%",
      "dark": "0 0% 63.9%",
      "usage": "補助テキスト・ラベル・プレースホルダ"
    },
    "accent": {
      "light": "0 0% 96.1%",
      "dark": "0 0% 14.9%",
      "usage": "ホバー面・選択中項目の背景"
    },
    "accent-foreground": {
      "light": "0 0% 9%",
      "dark": "0 0% 98%",
      "usage": "accent 面の上の文字色"
    },
    "border": {
      "light": "0 0% 89.8%",
      "dark": "0 0% 14.9%",
      "usage": "境界線・区切り線"
    },
    "input": {
      "light": "0 0% 89.8%",
      "dark": "0 0% 14.9%",
      "usage": "フォーム入力の枠線"
    },
    "ring": {
      "light": "0 0% 3.9%",
      "dark": "0 0% 83.1%",
      "usage": "フォーカスリング"
    }
  },

  "semantic": {
    "interactive": {
      "$default": "text",
      "$usage": "リンク・クリック可能テキスト。情報提示の info とは役割が違うので分ける",
      "text": {
        "light": "224 76.3% 48%",
        "dark": null,
        "contrast": 6.64,
        "usage": "background に載せる前景色（リンク文字）"
      },
      "surface": {
        "light": "214 94.6% 92.7%",
        "dark": null,
        "usage": "薄い面。必ず surface-foreground とセットで使う"
      },
      "surface-foreground": {
        "light": "226 70.7% 40.2%",
        "dark": null,
        "contrast": 7.15,
        "usage": "interactive-surface の上に載せる前景色"
      },
      "solid": {
        "light": "221 83.2% 53.3%",
        "dark": null,
        "contrast": 5.12,
        "usage": "アイコン塗り・ドット等の小面積オブジェクト（白グリフを載せる前提）"
      }
    },
    "success": {
      "$default": "text",
      "$usage": "正常・確定・完了の信号。オブジェクトの塗りには使わない",
      "text": {
        "light": "142 71.8% 29.2%",
        "dark": null,
        "contrast": 5.02,
        "usage": "background に載せる前景色"
      },
      "surface": {
        "light": "141 84.5% 92.5%",
        "dark": null,
        "usage": "薄い面。必ず surface-foreground とセットで使う"
      },
      "surface-foreground": {
        "light": "143 64.2% 24.1%",
        "dark": null,
        "contrast": 6.49,
        "usage": "success-surface の上に載せる前景色"
      },
      "solid": {
        "light": "142 71.8% 29.2%",
        "dark": null,
        "contrast": 5.02,
        "usage": "アイコン塗り・ドット等（白グリフを載せるため -700 相当まで暗くしてある）"
      }
    },
    "warning": {
      "$default": "text",
      "$usage": "注意・要確認",
      "text": {
        "light": "26 90.5% 37.1%",
        "dark": null,
        "contrast": 5.02,
        "usage": "background に載せる前景色"
      },
      "surface": {
        "light": "48 96.5% 88.8%",
        "dark": null,
        "usage": "薄い面。必ず surface-foreground とセットで使う"
      },
      "surface-foreground": {
        "light": "23 82.5% 31.4%",
        "dark": null,
        "contrast": 6.32,
        "usage": "warning-surface の上に載せる前景色"
      },
      "solid": {
        "light": "26 90.5% 37.1%",
        "dark": null,
        "contrast": 5.02,
        "usage": "アイコン塗り・ドット等（白グリフを載せる前提）"
      }
    },
    "info": {
      "$default": "text",
      "$usage": "情報・区分ラベル。押せないので interactive と混ぜない。interactive（青、hue 224）と見分けるため cyan 系（hue 194）に振ってある。success（緑、hue 141〜143）とも 50° 以上離す",
      "text": {
        "light": "194 69.6% 27.1%",
        "dark": null,
        "contrast": 7.18,
        "usage": "background に載せる前景色"
      },
      "surface": {
        "light": "185 95.9% 90.4%",
        "dark": null,
        "usage": "薄い面。必ず surface-foreground とセットで使う"
      },
      "surface-foreground": {
        "light": "196 63.6% 20.4%",
        "dark": null,
        "contrast": 9.56,
        "usage": "info-surface の上に載せる前景色"
      },
      "solid": {
        "light": "194 69.6% 27.1%",
        "dark": null,
        "contrast": 7.18,
        "usage": "アイコン塗り・ドット等の小面積オブジェクト（白グリフを載せる前提）"
      }
    },
    "inactive": {
      "$usage": "非アクティブ・期限切れ。非アクション・非情報の状態表現に限る（text / solid は用途なしのため未定義）",
      "surface": {
        "light": "220 13% 91%",
        "dark": "215 27.9% 16.9%",
        "usage": "無効行・無効バッジの面"
      },
      "surface-foreground": {
        "light": "215 13.8% 34.1%",
        "dark": "217.9 10.6% 64.9%",
        "contrast": 6.1,
        "contrastDark": 5.78,
        "usage": "inactive-surface の上に載せる前景色"
      }
    },
    "destructive": {
      "$default": "DEFAULT",
      "$usage": "破壊的操作・エラー。他の語彙と同じ3トーン体系で運用する",
      "DEFAULT": {
        "light": "0 72.2% 50.6%",
        "dark": "0 62.8% 30.6%",
        "usage": "破壊的アクションのベタ塗り面。destructive-foreground を載せて AA 4.63（純白なら 4.83）。旧値 0 84.2% 60.2% は 3.76 で AA 未達のため不採用"
      },
      "foreground": {
        "light": "0 0% 98%",
        "dark": "0 0% 98%",
        "usage": "destructive 面の上の文字色"
      },
      "text": {
        "light": "0 73.7% 41.8%",
        "dark": null,
        "contrast": 6.47,
        "usage": "background に載せるエラー文言の前景色"
      },
      "surface": {
        "light": "0 93.3% 94.1%",
        "dark": null,
        "usage": "薄い面。必ず surface-foreground とセットで使う"
      },
      "surface-foreground": {
        "light": "0 70% 35.3%",
        "dark": null,
        "contrast": 6.8,
        "usage": "destructive-surface の上に載せる前景色"
      }
    }
  },

  "radius": {
    "value": "0.5rem",
    "usage": "角丸の基準値。Tailwind の rounded-lg / -md / -sm が lg=var(--radius), md=calc(-2px), sm=calc(-4px) に対応する"
  }
}
